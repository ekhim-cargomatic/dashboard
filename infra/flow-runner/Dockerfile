# The image CodeBuild runs a flow chunk's tests in.
#
# Based on Microsoft's official Playwright Python image rather than a plain
# python:slim, because that image already carries Chromium and the ~40 system
# libraries it needs. Installing those by hand is the single most fragile part
# of running a browser in CI, and this is one line instead.
#
# The tag must track `playwright==` in playwright-automation/requirements.txt.
# If they drift, the browser on disk and the client driving it disagree, which
# surfaces as a baffling "Executable doesn't exist" at scenario one.
FROM mcr.microsoft.com/playwright/python:v1.55.0-jammy

# Node for ci/qa-summary.mjs and the AWS CLI for the upload. No git: the suite
# arrives as a zip from a private bucket, so the runner never clones anything.
# unzip and default-jre are Allure's: the CLI is a Java program shipped as a zip.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl unzip default-jre-headless ca-certificates \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscli.zip \
 && unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install \
 && rm -rf /tmp/awscli.zip /tmp/aws /var/lib/apt/lists/*

# Pinned to the version CI uses, so a report generated here and a report
# generated by smoke.yml are the same artifact.
ARG ALLURE_VERSION=2.24.1
RUN curl -fsSL -o /tmp/allure.zip \
      "https://repo.maven.apache.org/maven2/io/qameta/allure/allure-commandline/${ALLURE_VERSION}/allure-commandline-${ALLURE_VERSION}.zip" \
 && unzip -q /tmp/allure.zip -d /opt && rm /tmp/allure.zip \
 && ln -s "/opt/allure-${ALLURE_VERSION}/bin/allure" /usr/local/bin/allure

# Baked in so the build does not depend on this dashboard's repo being reachable.
# It is what makes a flow run indistinguishable from a CI run to the dashboard:
# same qa-summary.json schema, same run key, same prefix layout.
COPY qa-summary.mjs domains.generated.json /opt/qa/

# Python deps are NOT baked: requirements.txt travels with the suite, so a
# dependency change takes effect on the next --push-tests rather than needing
# this image rebuilt. The wheels are small and pip is fast; Chromium is the part
# worth baking.
WORKDIR /src
