__pycache__/

# Copied beside the function at deploy time (and by local-server.mjs) so plans
# resolve from the same map the dashboard serves. The original is the one in
# public/qa-flow; a committed duplicate is a second copy to forget to update.
infra/flow-run-fn/cargomatic.json
